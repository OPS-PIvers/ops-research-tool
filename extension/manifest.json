{
  "manifest_version": 3,
  "name": "OPS Research Tool",
  "version": "0.1.0",
  "description": "Highlight web sources, categorize by NHD phase, and capture citations. Internal to Orono Public Schools.",
  "permissions": [
    "storage",
    "alarms",
    "identity",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://accounts.google.com/*",
        "https://script.google.com/*",
        "*://*.google.com/recaptcha/*"
      ],
      "js": [
        "config.js",
        "shared/ids.js",
        "shared/url.js",
        "content/scrape.js",
        "content/sidebar.js",
        "content/marks.js",
        "content/toolbar.js"
      ],
      "css": ["content/toolbar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OPS Research Tool",
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf/panel.html",
        "vendor/pdf.min.mjs",
        "vendor/pdf.worker.min.mjs"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "oauth2": {
    "client_id": "251187181508-37t9ogl23osddoan29vjjq12331kh8un.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "openid"
    ]
  }
}
